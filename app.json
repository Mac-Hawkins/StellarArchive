{
  "expo": {
    "splash": {
      "image": "./assets/images/stellar-archive-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "name": "Stellar Archive",
    "slug": "StellarArchive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/stellar-archive-logo.png",
    "scheme": "stellararchive",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": ["INTERNET"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/stellar-archive-logo.png",
        "backgroundImage": "./assets/images/stellar-archive-logo.png",
        "monochromeImage": "./assets/images/stellar-archive-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/stellar-archive-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
